  "info": {
    "_postman_id": "808af499-64c1-49b6-8d5a-1963efeaf4ed",
    "name": "Leafly Integration Menu Status API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Near-real-time menu integration API for keeping a dispensary's Leafly menu in sync with its system of record (POS). When menu items are edited or inventory levels change, the system of record makes HTTP requests to the menu integration URL with a JSON payload of menu items. Every call is scoped by a Leafly-issued menu_integration_key path parameter. V2 authenticates with OAuth2 client credentials.\nThis OpenAPI document was authored by API Evangelist from Leafly's public ReDoc documentation (https://docs.leafly.io/menu-integration-docs/v2.html) for cataloging purposes. It reflects the documented endpoints and the item schema; it is not the vendor's own distributed specification.\n\nContact Support:\n Name: Leafly API Support\n Email: api-support@leafly.com",
      "type": "text/plain"
    }
